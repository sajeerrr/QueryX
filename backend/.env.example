# ===========================================
# QueryX Environment Configuration
# ===========================================

# Server Settings
HOST=0.0.0.0
PORT=8000

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=queryx_documents

# LLM API (Groq)
API_KEY=your_groq_api_key_here
CHAT_MODEL=llama-3.1-70b-versatile

# ===========================================
# PERFORMANCE SETTINGS (Optional)
# ===========================================

# Multi-Query Generation
# - true:  Generate 3 query variations for better retrieval (~6-8s slower)
# - false: Use single query (default, faster)
ENABLE_MULTI_QUERY=false

# Reranking
# - true:  Use cross-encoder for better ranking (~3-5s slower)
# - false: Use hybrid search scores directly (default, faster)
ENABLE_RERANKING=false
